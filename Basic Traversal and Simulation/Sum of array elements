//Sum of array elements

public class Main
{
	static int sumArr(int arr[]){
	    int sum = 0;
	    
	    if(arr == null | arr.length ==0){
	        return -1;
	    }
	    for(int i=0; i<arr.length; i++){
	        sum +=arr[i];
	        }
	    return sum;
	}
	
	public static void main(String[] args) {
		int[] arr = {1,4,92,34,44,84,2,-3};
		System.out.println(sumArr(arr));
		
	}
}
