//Finding min element 

public class Main
{
	static int findMin(int arr[]){
	     if(arr== null | arr.length==0){
	        return -1;
	    }
	    int min = arr[0];
	    
	    for(int i=1; i<arr.length; i++){
	        if (arr[i] < min){
	            min = arr[i];
	        }
	    }
	    
	    return min;
	}
	
	public static void main(String[] args) {
		int[] arr = {1,34,2,334,2,-3};
		System.out.println(findMin(arr));
		
	}
}
