//Find index of first occurrence

public class Main
{
	static int findIndex(int arr[], int target){
	    for(int i=0; i<arr.length; i++){
	        if (arr[i] == target){
	            return i;
	        }
	    }
	    
	    return -1;
	}
	
	public static void main(String[] args) {
		int[] arr = {1,4,2,34,44,34,2,-3};
		int target = 34;
		System.out.println(findIndex(arr, target));
		
	}
}
