//Finding max element 

public class Main
{
	static int findMax(int arr[]){
	     if(arr== null | arr.length==0){
	        return -1;
	    }
	    int max = arr[0];
	    
	    for(int i=1; i<arr.length; i++){
	        if (arr[i] > max){
	            max = arr[i];
	        }
	    }
	    
	    return max;
	}
	
	public static void main(String[] args) {
		int[] arr = {1,34,2,34,44,34,2,-3};
		System.out.println(findMax(arr));
		
	}
}
