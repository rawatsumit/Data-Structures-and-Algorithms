// two sum - sorted array

public class Main
{
    static Boolean twoSum(int[] arr, int k){
        int left = 0;
        int right = arr.length-1;
        
        while (left < right){
            if(arr[left] + arr[right] < k){
                left++;
            }
            else if( arr[left] + arr[right] > k){
                right--;
            }
            else
                return true;
        }
        return false;
    }
    
	public static void main(String[] args) {
		int[] arr = {1,3,5,7,8,9,46,56};
		int target = 49;
		System.out.println("Does array contain target sum: " + twoSum(arr, target));
	}
}
