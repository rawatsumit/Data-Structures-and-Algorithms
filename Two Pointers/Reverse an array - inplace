// reverse an array - inplace

public class Main
{
    static void revArr(char[] arr){
        int left = 0;
        int right = arr.length-1;
        
        while (left < right){
            char temp = arr[left];
            arr[left] = arr[right];
            arr[right] = temp;
        
            left++;
            right--;
        }
    }
    
    static void printArr(char[] arr){
        for(char a : arr)
            System.out.print(a+" ");
    }
    
	public static void main(String[] args) {
		char[] arr = {'h', 'e','l','l','o','!'};
		
		revArr(arr);
		printArr(arr);
	}
}
